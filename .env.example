# Copy this file to `.env` and adjust as needed. `.env` is git-ignored.
# Never put real API keys, tokens, or passwords in this file.

# Interface the Express server listens on. Keep this on loopback (127.0.0.1):
# the server forwards HTTP requests on your behalf and must not be exposed
# to other machines.
SERVER_HOST=127.0.0.1

# Port for the Express server. The Vite dev server proxies /api/* here.
SERVER_PORT=3001
